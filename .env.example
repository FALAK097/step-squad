# Neon Auth & Data API (Managed Better Auth + PostgREST)
EXPO_PUBLIC_NEON_AUTH_URL=https://<your-branch>.neonauth.<region>.aws.neon.tech/<dbname>/auth
EXPO_PUBLIC_NEON_DATA_API_URL=https://<your-branch>.apirest.<region>.aws.neon.build/<dbname>/rest/v1

# Direct Database URL for migrations and data import (backend/scripts only)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
